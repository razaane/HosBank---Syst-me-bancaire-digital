<style>
  :root {
    --bg: #FAF9F5; --surface: #FFFFFF; --border: #E8E6DC;
    --text: #141413; --text-muted: #6B6A64;
    --accent: #D97757; --accent-dark: #C6613F;
  }
  body { background: var(--bg); color: var(--text); font-family: 'Inter', sans-serif; margin: 0; }
  h1, h2 { font-family: 'Lora', serif; }
  .layout { display: flex; min-height: 100vh; }
  .sidebar { width: 220px; background: var(--surface); border-right: 1px solid var(--border); padding: 24px 16px; }
  .sidebar a { display: block; padding: 8px 12px; border-radius: 0; color: var(--text-muted); text-decoration: none; font-size: 14px; margin-bottom: 4px; }
  .sidebar a:hover { background: var(--bg); color: var(--text); }
  .sidebar a.active { background: var(--accent); color: white; }
  .main { flex: 1; padding: 32px 40px; }
  .card { background: var(--surface); border: 1px solid var(--border); border-radius: 0; padding: 24px; }
  table { width: 100%; border-collapse: collapse; font-size: 14px; }
  th { text-align: left; color: var(--text-muted); font-weight: 500; padding: 10px 12px; border-bottom: 1px solid var(--border); }
  td { padding: 10px 12px; border-bottom: 1px solid var(--border); }
  select, input { border: 1px solid var(--border); border-radius: 0; padding: 4px 8px; font-size: 13px; }
  button, .btn { background: var(--accent); color: white; border: none; border-radius: 0; padding: 6px 14px; font-size: 13px; cursor: pointer; }
  button:hover { background: var(--accent-dark); }
  .btn-outline { background: transparent; border: 1px solid var(--border); color: var(--text); }
  .badge { padding: 2px 10px; border-radius: 0; font-size: 12px; }
  .stat-card { background: var(--surface); border: 1px solid var(--border); border-radius: 0; padding: 20px; }
  .stat-label { color: var(--text-muted); font-size: 13px; }
  .stat-value { font-family: 'Lora', serif; font-size: 28px; margin-top: 4px; }
</style>

<div class="layout">
  <aside class="sidebar">
    <h2 style="font-size:18px;margin-bottom:24px;">HosBank <span style="color:var(--accent)">Admin</span></h2>
    <a href="/admin/utilisateurs" class="<%= page==='utilisateurs'?'active':'' %>">Utilisateurs</a>
    <a href="/admin/affectation" class="<%= page==='affectation'?'active':'' %>">Affectation</a>
    <a href="/admin/comptes" class="<%= page==='comptes'?'active':'' %>">Comptes</a>
    <a href="/admin/cartes" class="<%= page==='cartes'?'active':'' %>">Cartes</a>
    <a href="/admin/virements" class="<%= page==='virements'?'active':'' %>">Virements</a>
    <a href="/admin/demandes" class="<%= page==='demandes'?'active':'' %>">Demandes</a>
    <a href="/admin/reclamations" class="<%= page==='reclamations'?'active':'' %>">Réclamations</a>
    <a href="/admin/supervision" class="<%= page==='supervision'?'active':'' %>">Supervision</a>
    <a href="/admin/stats" class="<%= page==='stats'?'active':'' %>">Statistiques</a>
  </aside>
  <main class="main">
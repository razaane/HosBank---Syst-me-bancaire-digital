<!DOCTYPE html>
<html lang="fr">
<head>
  <%- include('../partials/head') %>
  <title>Vérification échouée - HosBank</title>
</head>
<body class="bg-[#fcf9f6] text-[#1c1c1a] antialiased min-h-screen flex items-center justify-center px-4">
  <div class="w-full max-w-md flex flex-col gap-8">

    <div class="flex flex-col items-center gap-2">
      <span class="text-2xl font-semibold tracking-tight">HosBank</span>
    </div>

    <div class="bg-white rounded-2xl p-8 shadow-sm flex flex-col items-center gap-5 text-center">
      <div class="w-14 h-14 rounded-full bg-[#ffdad6] flex items-center justify-center">
        <span class="material-symbols-outlined text-[#ba1a1a] text-[28px]">error</span>
      </div>
      <div class="flex flex-col gap-1">
        <h1 class="text-xl font-serif-num tracking-tight">Vérification échouée</h1>
        <p class="text-sm text-[#55433d]"><%= error %></p>
      </div>
      <a href="/register"
        class="h-11 px-6 rounded-xl bg-[#99462a] text-white text-sm font-medium hover:opacity-90 transition-all flex items-center gap-2">
        Retour à l'inscription
        <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
      </a>
    </div>
  </div>
</body>
</html>
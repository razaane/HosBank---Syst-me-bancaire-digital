<!DOCTYPE html>
<html lang="fr">
<head>
  <%- include('../partials/head') %>
  <title>Inscription - HosBank</title>
</head>
<body class="bg-[#fcf9f6] text-[#1c1c1a] antialiased min-h-screen flex items-center justify-center px-4 py-10">
  <div class="w-full max-w-md flex flex-col gap-8">

    <div class="flex flex-col items-center gap-2">
      <span class="text-2xl font-semibold tracking-tight">HosBank</span>
      <span class="text-xs text-[#55433d] uppercase tracking-widest">Espace Particulier</span>
    </div>

    <div class="bg-white rounded-2xl p-8 shadow-sm flex flex-col gap-6">
      <div class="flex flex-col gap-1">
        <h1 class="text-2xl font-serif-num tracking-tight">Créer un compte</h1>
        <p class="text-sm text-[#55433d]">Rejoignez HosBank en quelques secondes</p>
      </div>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="p-3.5 rounded-xl bg-[#ffdad6]/60 flex items-start gap-3">
          <span class="material-symbols-outlined text-[#ba1a1a] text-[20px]">error</span>
          <p class="text-sm text-[#93000a]"><%= error %></p>
        </div>
      <% } %>

      <form action="/register" method="POST" class="flex flex-col gap-4">
        <div class="grid grid-cols-2 gap-3">
          <div class="flex flex-col gap-2">
            <label class="text-xs uppercase tracking-wider text-[#55433d] font-medium" for="nom">Nom</label>
            <input type="text" name="nom" id="nom" required placeholder="Bennani"
              class="w-full h-12 px-4 rounded-xl bg-[#f6f3f1] text-sm focus:outline-none focus:ring-1 focus:ring-[#99462a]">
          </div>
          <div class="flex flex-col gap-2">
            <label class="text-xs uppercase tracking-wider text-[#55433d] font-medium" for="prenom">Prénom</label>
            <input type="text" name="prenom" id="prenom" required placeholder="Yassine"
              class="w-full h-12 px-4 rounded-xl bg-[#f6f3f1] text-sm focus:outline-none focus:ring-1 focus:ring-[#99462a]">
          </div>
        </div>
        <div class="flex flex-col gap-2">
          <label class="text-xs uppercase tracking-wider text-[#55433d] font-medium" for="cin">CIN</label>
          <input type="text" name="cin" id="cin" required placeholder="AB123456"
            class="w-full h-12 px-4 rounded-xl bg-[#f6f3f1] text-sm focus:outline-none focus:ring-1 focus:ring-[#99462a]">
        </div>
        <div class="flex flex-col gap-2">
          <label class="text-xs uppercase tracking-wider text-[#55433d] font-medium" for="telephone">Téléphone</label>
          <input type="text" name="telephone" id="telephone" required placeholder="+212 6XX XXX XXX"
            class="w-full h-12 px-4 rounded-xl bg-[#f6f3f1] text-sm focus:outline-none focus:ring-1 focus:ring-[#99462a]">
        </div>
        <div class="flex flex-col gap-2">
          <label class="text-xs uppercase tracking-wider text-[#55433d] font-medium" for="dateNaissance">Date de naissance</label>
          <input type="date" name="dateNaissance" id="dateNaissance" required
            class="w-full h-12 px-4 rounded-xl bg-[#f6f3f1] text-sm focus:outline-none focus:ring-1 focus:ring-[#99462a]">
        </div>
        <div class="flex flex-col gap-2">
          <label class="text-xs uppercase tracking-wider text-[#55433d] font-medium" for="adresse">Adresse</label>
          <input type="text" name="adresse" id="adresse" required placeholder="Casablanca"
            class="w-full h-12 px-4 rounded-xl bg-[#f6f3f1] text-sm focus:outline-none focus:ring-1 focus:ring-[#99462a]">
        </div>
         <div class="flex flex-col gap-2">
          <label class="text-xs uppercase tracking-wider text-[#55433d] font-medium" for="email">Email</label>
          <input type="email" name="email" id="email" required placeholder="vous@exemple.com"
            class="w-full h-12 px-4 rounded-xl bg-[#f6f3f1] text-sm focus:outline-none focus:ring-1 focus:ring-[#99462a]">
        </div>
        <div class="flex flex-col gap-2">
          <label class="text-xs uppercase tracking-wider text-[#55433d] font-medium" for="motPass">Mot de passe</label>
          <input type="password" name="motPass" id="motPass" required placeholder="••••••••"
            class="w-full h-12 px-4 rounded-xl bg-[#f6f3f1] text-sm focus:outline-none focus:ring-1 focus:ring-[#99462a]">
        </div>
        <button type="submit"
          class="h-12 rounded-xl bg-[#99462a] text-white font-medium hover:opacity-90 transition-all flex items-center justify-center gap-2 mt-2">
          Créer mon compte
          <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
        </button>
      </form>
    </div>

    <p class="text-center text-sm text-[#55433d]">
      Déjà un compte ?
      <a href="/login" class="text-[#99462a] font-medium hover:underline">Se connecter</a>
    </p>
  </div>
</body>
</html>
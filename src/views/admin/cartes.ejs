<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8"><title>Cartes - HosBank Admin</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=Lora:wght@500;600&display=swap" rel="stylesheet">
</head>
<body>
<%- include('../partials/adminNav', { page: 'cartes' }) %>
  <h1 style="margin-bottom:24px;">Cartes</h1>
  <div class="card">
    <table>
      <thead><tr><th>Client</th><th>N° Carte</th><th>Type</th><th>Statut</th><th></th></tr></thead>
      <tbody>
      <% cartes.forEach(c => { %>
        <tr>
          <td><%= c.prenom %> <%= c.nom %></td>
          <td><%= c.numero_carte %></td>
          <td><%= c.type_carte %></td>
          <td><span class="badge" style="background:#F0EEE6;"><%= c.statut %></span></td>
          <td>
            <form action="/admin/cartes/<%= c.id %>/statut" method="POST" style="display:flex;gap:6px;">
              <select name="statut">
                <% ['active','opposee','expiree','en_attente'].forEach(s => { %>
                  <option value="<%= s %>" <%= c.statut===s?'selected':'' %>><%= s %></option>
                <% }) %>
              </select>
              <button type="submit">OK</button>
            </form>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>

</main></div>
</body></html>
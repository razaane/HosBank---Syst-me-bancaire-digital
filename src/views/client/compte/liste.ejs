<!DOCTYPE html>
<html lang="fr">
<head>
  <%- include('../../partials/head') %>
  <title>Mes comptes - HosBank</title>
</head>
<body class="bg-[#fcf9f6] text-[#1c1c1a] antialiased">
  <%- include('../../partials/sidebar', { active: 'comptes' }) %>
  <div class="pl-64">
    <main class="max-w-[1000px] mx-auto px-6 lg:px-10 py-10 flex flex-col gap-8">
      <div class="flex items-end justify-between gap-4">
        <div class="flex flex-col gap-1">
          <span class="text-xs text-[#99462a] uppercase tracking-widest font-semibold">Patrimoine</span>
          <h1 class="text-3xl font-serif-num tracking-tight">Mes comptes</h1>
        </div>
        <a href="/comptes/epargne" class="h-11 px-5 rounded-xl bg-[#99462a] text-white text-sm font-medium hover:opacity-90 transition-all flex items-center gap-2">
          <span class="material-symbols-outlined text-[18px]">savings</span> Ouvrir un compte épargne
        </a>
      </div>
      <% if (comptes.length === 0) { %>
        <div class="bg-white rounded-2xl p-6 shadow-sm"><p class="text-[#55433d] text-sm">Aucun compte pour le moment.</p></div>
      <% } else { %>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
          <% const statutStyle = { actif: 'bg-[#d4e8d0] text-[#3a4b39]', suspendu: 'bg-[#ffdad6] text-[#93000a]', ferme: 'bg-[#e5e2e0] text-[#55433d]', en_attente_ouverture: 'bg-[#f6f3f1] text-[#55433d]' }; %>
          <% comptes.forEach(c => { %>
            <article class="bg-white rounded-2xl p-6 shadow-sm">
              <div class="flex items-start justify-between mb-4">
                <div>
                  <span class="text-xs text-[#55433d] uppercase tracking-wider block mb-1"><%= c.type_compte === 'epargne' ? 'Compte Épargne' : 'Compte Courant' %></span>
                  <p class="text-sm text-[#55433d] font-mono"><%= c.numero_compte %></p>
                </div>
                <span class="px-2.5 py-1 rounded-full text-xs font-medium <%= statutStyle[c.statut] || 'bg-[#f6f3f1] text-[#55433d]' %>"><%= c.statut %></span>
              </div>
              <div class="mb-4">
                <span class="text-xs text-[#55433d] block mb-1">Solde</span>
                <div class="flex items-baseline gap-2">
                  <span class="text-3xl font-serif-num"><%= Number(c.solde).toFixed(2) %></span><span class="text-lg text-[#55433d]">DH</span>
                </div>
              </div>
              <div class="pt-3 border-t border-[#f0edeb] text-xs text-[#55433d]">Ouvert le <%= c.date_ouverture %></div>
            </article>
          <% }) %>
        </div>
      <% } %>
    </main>
  </div>
</body>
</html>
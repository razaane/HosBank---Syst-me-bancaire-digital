<!DOCTYPE html>
<html lang="fr">
<head>
  <%- include('../../partials/head') %>
  <title>Effectuer un virement - HosBank</title>
</head>
<body class="bg-[#fcf9f6] text-[#1c1c1a] antialiased">
  <%- include('../../partials/sidebar', { active: 'virements' }) %>
  <div class="pl-64">
    <main class="max-w-[800px] mx-auto px-6 lg:px-10 py-10 flex flex-col gap-8">
      <div class="flex flex-col gap-1">
        <span class="text-xs text-[#99462a] uppercase tracking-widest font-semibold">Opération de transfert</span>
        <h1 class="text-3xl font-serif-num tracking-tight">Effectuer un virement</h1>
      </div>
      <% if (beneficiaires.length === 0) { %>
        <div class="bg-white rounded-2xl p-6 shadow-sm">
          <p class="text-[#55433d] text-sm">Vous n'avez aucun bénéficiaire enregistré.</p>
          <a href="/beneficiaires/ajouter" class="inline-block mt-3 text-[#99462a] text-sm font-medium hover:underline">+ Ajouter un bénéficiaire</a>
        </div>
      <% } else { %>
        <form action="/virements" method="POST" class="bg-white rounded-2xl p-6 shadow-sm flex flex-col gap-5">
          <div class="flex flex-col gap-2">
            <label class="text-xs uppercase tracking-wider text-[#55433d] font-medium">Bénéficiaire</label>
            <select name="beneficiaireId" required class="w-full h-12 px-4 rounded-xl bg-[#f6f3f1] text-sm focus:outline-none focus:ring-1 focus:ring-[#99462a]">
              <option value="">-- Choisir un bénéficiaire --</option>
              <% beneficiaires.forEach(b => { %><option value="<%= b.id %>"><%= b.nom %> (<%= b.rib %>)</option><% }) %>
            </select>
          </div>
          <div class="flex flex-col gap-2">
            <label class="text-xs uppercase tracking-wider text-[#55433d] font-medium">Montant</label>
            <div class="flex items-baseline gap-2 px-4 h-14 rounded-xl bg-[#f6f3f1] focus-within:ring-1 focus-within:ring-[#99462a]">
              <input type="number" step="0.01" name="montant" required placeholder="0.00" class="flex-1 bg-transparent text-2xl font-serif-num focus:outline-none">
              <span class="text-[#55433d] font-medium">DH</span>
            </div>
          </div>
          <div class="flex flex-col gap-2">
            <label class="text-xs uppercase tracking-wider text-[#55433d] font-medium">Motif</label>
            <input type="text" name="motif" placeholder="Ex: Loyer, remboursement..." class="w-full h-12 px-4 rounded-xl bg-[#f6f3f1] text-sm focus:outline-none focus:ring-1 focus:ring-[#99462a]">
          </div>
          <button type="submit" class="h-12 rounded-xl bg-[#99462a] text-white font-medium hover:opacity-90 transition-all flex items-center justify-center gap-2">
            Envoyer le virement <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
          </button>
        </form>
      <% } %>
      <a href="/virements" class="text-sm text-[#55433d] hover:text-[#99462a] flex items-center gap-1.5">
        <span class="material-symbols-outlined text-[16px]">history</span> Voir l'historique des virements
      </a>
    </main>
  </div>
</body>
</html>
<!DOCTYPE html>
<html lang="fr">
<head>
  <%- include('../../partials/head') %>
  <title>Historique des virements - HosBank</title>
</head>
<body class="bg-[#fcf9f6] text-[#1c1c1a] antialiased">
  <%- include('../../partials/sidebar', { active: 'virements' }) %>
  <div class="pl-64">
    <main class="max-w-[1000px] mx-auto px-6 lg:px-10 py-10 flex flex-col gap-8">
      <div class="flex items-end justify-between gap-4">
        <div class="flex flex-col gap-1">
          <span class="text-xs text-[#99462a] uppercase tracking-widest font-semibold">Historique</span>
          <h1 class="text-3xl font-serif-num tracking-tight">Mes virements</h1>
        </div>
        <a href="/virements/effectuer" class="h-11 px-5 rounded-xl bg-[#99462a] text-white text-sm font-medium hover:opacity-90 transition-all flex items-center gap-2">
          <span class="material-symbols-outlined text-[18px]">send_money</span> Nouveau virement
        </a>
      </div>
      <div class="bg-white rounded-2xl shadow-sm overflow-hidden">
        <% if (virements.length === 0) { %>
          <p class="p-6 text-[#55433d] text-sm">Aucun virement pour le moment.</p>
        <% } else { %>
          <table class="w-full text-left">
            <thead><tr class="bg-[#f6f3f1] text-xs uppercase tracking-wider text-[#55433d]">
              <th class="py-3 px-5">Date</th><th class="py-3 px-5">Motif</th><th class="py-3 px-5 text-right">Montant</th><th class="py-3 px-5">Statut</th>
            </tr></thead>
            <tbody class="divide-y divide-[#f0edeb]">
              <% const statutStyle = { en_attente: 'bg-[#f6f3f1] text-[#55433d]', valide: 'bg-[#d4e8d0] text-[#3a4b39]', echoue: 'bg-[#ffdad6] text-[#93000a]', annule: 'bg-[#e5e2e0] text-[#55433d]' }; %>
              <% virements.forEach(v => { %>
                <tr class="hover:bg-[#f6f3f1]/60 transition-colors">
                  <td class="py-4 px-5 text-sm text-[#55433d]"><%= v.dateVirement %></td>
                  <td class="py-4 px-5 text-sm"><%= v.motif || '—' %></td>
                  <td class="py-4 px-5 text-right font-serif-num text-lg">-<%= Number(v.montant).toFixed(2) %> DH</td>
                  <td class="py-4 px-5"><span class="px-2.5 py-1 rounded-full text-xs font-medium <%= statutStyle[v.statut] || 'bg-[#f6f3f1] text-[#55433d]' %>"><%= v.statut %></span></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } %>
      </div>
    </main>
  </div>
</body>
</html>
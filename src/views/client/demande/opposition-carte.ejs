<!DOCTYPE html>
<html lang="fr">
<head>
  <%- include('../../partials/head') %>
  <title>Opposition sur carte - HosBank</title>
</head>
<body class="bg-[#fcf9f6] text-[#1c1c1a] antialiased">
  <%- include('../../partials/sidebar', { active: 'demandes' }) %>
  <div class="pl-64">
    <main class="max-w-[700px] mx-auto px-6 lg:px-10 py-10 flex flex-col gap-6">
      <div class="flex flex-col gap-1">
        <span class="text-xs text-[#ba1a1a] uppercase tracking-widest font-semibold">Sécurité</span>
        <h1 class="text-3xl font-serif-num tracking-tight">Opposition sur carte</h1>
      </div>
      <div class="bg-white rounded-2xl p-7 shadow-sm flex flex-col gap-5">
        <div class="p-3.5 rounded-xl bg-[#ffdad6]/60 flex items-start gap-3">
          <span class="material-symbols-outlined text-[#ba1a1a] text-[20px]">warning</span>
          <p class="text-sm text-[#93000a]">Cette action bloque la carte immédiatement et de façon irréversible.</p>
        </div>
        <% if (cartes.length === 0) { %>
          <p class="text-sm text-[#55433d]">Aucune carte active disponible pour opposition.</p>
        <% } else { %>
          <form action="/demandes/opposition-carte" method="POST" class="flex flex-col gap-5">
            <div class="flex flex-col gap-2">
              <label class="text-xs uppercase tracking-wider text-[#55433d] font-medium">Choisir la carte</label>
              <select name="carteId" required class="w-full h-12 px-4 rounded-xl bg-[#f6f3f1] text-sm focus:outline-none focus:ring-1 focus:ring-[#ba1a1a]">
                <% cartes.forEach(c => { %><option value="<%= c.id %>"><%= c.numero_carte %> (<%= c.statut %>)</option><% }) %>
              </select>
            </div>
            <button type="submit" class="h-12 rounded-xl bg-[#ba1a1a] text-white font-medium hover:opacity-90 transition-all flex items-center justify-center gap-2">
              Confirmer l'opposition <span class="material-symbols-outlined text-[18px]">gpp_bad</span>
            </button>
          </form>
        <% } %>
      </div>
      <a href="/demandes" class="text-sm text-[#55433d] hover:text-[#99462a] flex items-center gap-1.5">
        <span class="material-symbols-outlined text-[16px]">arrow_back</span> Voir mes demandes
      </a>
    </main>
  </div>
</body>
</html>
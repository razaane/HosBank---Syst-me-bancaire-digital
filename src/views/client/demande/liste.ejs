<!DOCTYPE html>
<html lang="fr">
<head>
  <%- include('../../partials/head') %>
  <title>Mes demandes - HosBank</title>
</head>
<body class="bg-[#fcf9f6] text-[#1c1c1a] antialiased">
  <%- include('../../partials/sidebar', { active: 'demandes' }) %>
  <div class="pl-64">
    <main class="max-w-[1000px] mx-auto px-6 lg:px-10 py-10 flex flex-col gap-8">
      <div class="flex flex-col gap-1">
        <span class="text-xs text-[#99462a] uppercase tracking-widest font-semibold">Suivi</span>
        <h1 class="text-3xl font-serif-num tracking-tight">Mes demandes</h1>
      </div>
      <section class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        <a href="/demandes/carte-virtuelle" class="flex items-center gap-3 px-4 py-3.5 rounded-xl bg-white hover:bg-[#f6f3f1] transition-all shadow-sm">
          <span class="material-symbols-outlined text-[20px] text-[#99462a]">credit_card</span><span class="font-medium text-sm">Carte virtuelle</span>
        </a>
        <a href="/demandes/opposition-carte" class="flex items-center gap-3 px-4 py-3.5 rounded-xl bg-white hover:bg-[#f6f3f1] transition-all shadow-sm">
          <span class="material-symbols-outlined text-[20px] text-[#ba1a1a]">block</span><span class="font-medium text-sm">Opposition carte</span>
        </a>
        <a href="/demandes/renouvellement-pin" class="flex items-center gap-3 px-4 py-3.5 rounded-xl bg-white hover:bg-[#f6f3f1] transition-all shadow-sm">
          <span class="material-symbols-outlined text-[20px] text-[#55433d]">dialpad</span><span class="font-medium text-sm">Renouveler PIN</span>
        </a>
      </section>
      <div class="bg-white rounded-2xl shadow-sm overflow-hidden">
        <% const libellesType = { carte_virtuelle: 'Carte virtuelle', opposition_carte: 'Opposition carte', renouvellement_pin: 'Renouvellement PIN', ouverture_epargne: "Ouverture d'épargne", rib: 'Demande de RIB' };
           const libellesStatut = { en_attente: 'En attente', en_cours: 'En cours', validee: 'Validée', refusee: 'Refusée' };
           const statutStyle = { en_attente: 'bg-[#f6f3f1] text-[#55433d]', en_cours: 'bg-[#fff3cd] text-[#856404]', validee: 'bg-[#d4e8d0] text-[#3a4b39]', refusee: 'bg-[#ffdad6] text-[#93000a]' };
        %>
        <% if (demandes.length === 0) { %>
          <p class="p-6 text-[#55433d] text-sm">Aucune demande pour le moment.</p>
        <% } else { %>
          <table class="w-full text-left">
            <thead><tr class="bg-[#f6f3f1] text-xs uppercase tracking-wider text-[#55433d]"><th class="py-3 px-5">Type</th><th class="py-3 px-5">Date</th><th class="py-3 px-5">Statut</th></tr></thead>
            <tbody class="divide-y divide-[#f0edeb]">
              <% demandes.forEach(d => { %>
                <tr class="hover:bg-[#f6f3f1]/60 transition-colors">
                  <td class="py-4 px-5 text-sm font-medium"><%= libellesType[d.typeDemande] || d.typeDemande %></td>
                  <td class="py-4 px-5 text-sm text-[#55433d]"><%= d.dateCreation %></td>
                  <td class="py-4 px-5"><span class="px-2.5 py-1 rounded-full text-xs font-medium <%= statutStyle[d.statut] || 'bg-[#f6f3f1] text-[#55433d]' %>"><%= libellesStatut[d.statut] || d.statut %></span></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } %>
      </div>
    </main>
  </div>
</body>
</html>
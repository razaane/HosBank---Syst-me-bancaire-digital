<!DOCTYPE html>
<html lang="fr">
<head>
  <%- include('../../partials/head') %>
  <title>Mes bénéficiaires - HosBank</title>
</head>
<body class="bg-[#fcf9f6] text-[#1c1c1a] antialiased">
  <%- include('../../partials/sidebar', { active: 'beneficiaires' }) %>
  <div class="pl-64">
    <main class="max-w-[900px] mx-auto px-6 lg:px-10 py-10 flex flex-col gap-8">

      <div class="flex items-end justify-between gap-4">
        <div class="flex flex-col gap-1">
          <span class="text-xs text-[#99462a] uppercase tracking-widest font-semibold">Contacts</span>
          <h1 class="text-3xl font-serif-num tracking-tight">Mes bénéficiaires</h1>
        </div>
        <a href="/beneficiaires/ajouter" class="h-11 px-5 rounded-xl bg-[#99462a] text-white text-sm font-medium hover:opacity-90 transition-all flex items-center gap-2">
          <span class="material-symbols-outlined text-[18px]">person_add</span> Ajouter
        </a>
      </div>

      <% if (beneficiaires.length === 0) { %>
        <div class="bg-white rounded-2xl p-6 shadow-sm">
          <p class="text-[#55433d] text-sm">Aucun bénéficiaire enregistré pour le moment.</p>
        </div>
      <% } else { %>
        <div class="flex flex-col gap-3">
          <% beneficiaires.forEach(b => { %>
            <div class="bg-white rounded-2xl p-5 shadow-sm flex items-center justify-between gap-4">
              <div class="flex items-center gap-4">
                <div class="w-10 h-10 rounded-full bg-[#f6f3f1] flex items-center justify-center text-[#99462a] font-semibold">
                  <%= b.nom.charAt(0).toUpperCase() %>
                </div>
                <div>
                  <p class="font-medium text-sm"><%= b.nom %></p>
                  <p class="text-xs text-[#55433d] font-mono"><%= b.rib %><%= b.banque ? ' · ' + b.banque : '' %></p>
                </div>
              </div>
              <form action="/beneficiaires/<%= b.id %>/supprimer" method="POST">
                <button type="submit"
                  class="h-9 px-3 rounded-lg bg-[#f6f3f1] hover:bg-[#ffdad6] text-[#55433d] hover:text-[#ba1a1a] text-xs font-medium transition-colors flex items-center gap-1.5">
                  <span class="material-symbols-outlined text-[16px]">delete</span> Supprimer
                </button>
              </form>
            </div>
          <% }) %>
        </div>
      <% } %>
    </main>
  </div>
</body>
</html>
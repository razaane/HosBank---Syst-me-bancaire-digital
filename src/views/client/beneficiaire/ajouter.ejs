<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Ajouter un bénéficiaire</title>
</head>
<body>
  <h1>Ajouter un bénéficiaire</h1>

  <form action="/beneficiaires" method="POST">
    <input type="text" name="nom" placeholder="Nom" required>
    <input type="text" name="rib" placeholder="RIB" required>
    <input type="text" name="banque" placeholder="Banque">
    <button type="submit">Ajouter</button>
  </form>

  <a href="/beneficiaires">Retour à la liste</a>
</body>
</html>
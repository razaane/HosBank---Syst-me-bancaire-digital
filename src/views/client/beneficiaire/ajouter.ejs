<!DOCTYPE html>
<html lang="fr">
<head>
  <%- include('../../partials/head') %>
  <title>Ajouter un bénéficiaire - HosBank</title>
</head>
<body class="bg-[#fcf9f6] text-[#1c1c1a] antialiased">
  <%- include('../../partials/sidebar', { active: 'beneficiaires' }) %>
  <div class="pl-64">
    <main class="max-w-[900px] mx-auto px-6 lg:px-10 py-10 flex flex-col gap-8">

      <div class="flex flex-col gap-1">
        <span class="text-xs text-[#99462a] uppercase tracking-widest font-semibold">Contacts</span>
        <h1 class="text-3xl font-serif-num tracking-tight">Ajouter un bénéficiaire</h1>
      </div>

      <form action="/beneficiaires" method="POST" class="bg-white rounded-2xl p-6 shadow-sm flex flex-col gap-5">
        <div class="flex flex-col gap-2">
          <label class="text-xs uppercase tracking-wider text-[#55433d] font-medium" for="nom">Nom</label>
          <input type="text" name="nom" id="nom" required placeholder="Ex: Salma Bennani"
            class="w-full h-12 px-4 rounded-xl bg-[#f6f3f1] text-sm focus:outline-none focus:ring-1 focus:ring-[#99462a]">
        </div>
        <div class="flex flex-col gap-2">
          <label class="text-xs uppercase tracking-wider text-[#55433d] font-medium" for="rib">RIB</label>
          <input type="text" name="rib" id="rib" required placeholder="011 780 0000123456789012 34"
            class="w-full h-12 px-4 rounded-xl bg-[#f6f3f1] text-sm font-mono focus:outline-none focus:ring-1 focus:ring-[#99462a]">
        </div>
        <div class="flex flex-col gap-2">
          <label class="text-xs uppercase tracking-wider text-[#55433d] font-medium" for="banque">Banque</label>
          <input type="text" name="banque" id="banque" placeholder="Ex: BMCE Bank"
            class="w-full h-12 px-4 rounded-xl bg-[#f6f3f1] text-sm focus:outline-none focus:ring-1 focus:ring-[#99462a]">
        </div>
        <button type="submit"
          class="h-12 rounded-xl bg-[#99462a] text-white font-medium hover:opacity-90 transition-all flex items-center justify-center gap-2">
          Ajouter le bénéficiaire
          <span class="material-symbols-outlined text-[18px]">check</span>
        </button>
      </form>

      <a href="/beneficiaires" class="text-sm text-[#55433d] hover:text-[#99462a] flex items-center gap-1.5">
        <span class="material-symbols-outlined text-[16px]">arrow_back</span> Retour à la liste
      </a>
    </main>
  </div>
</body>
</html>
<!DOCTYPE html>
<html lang="fr">
<head>
  <%- include('../../partials/head') %>
  <title>Réclamations - HosBank</title>
</head>
<body class="bg-[#fcf9f6] text-[#1c1c1a] antialiased">
  <%- include('../../partials/sidebar', { active: 'reclamations' }) %>
  <div class="pl-64">
    <main class="max-w-[900px] mx-auto px-6 lg:px-10 py-10 flex flex-col gap-8">
      <div class="flex items-end justify-between gap-4">
        <div class="flex flex-col gap-1">
          <span class="text-xs text-[#99462a] uppercase tracking-widest font-semibold">Support</span>
          <h1 class="text-3xl font-serif-num tracking-tight">Mes réclamations</h1>
        </div>
        <a href="/reclamations/ajouter" class="h-11 px-5 rounded-xl bg-[#99462a] text-white text-sm font-medium hover:opacity-90 transition-all flex items-center gap-2">
          <span class="material-symbols-outlined text-[18px]">add</span> Nouvelle réclamation
        </a>
      </div>
      <% if (reclamations.length === 0) { %>
        <div class="bg-white rounded-2xl p-6 shadow-sm"><p class="text-[#55433d] text-sm">Aucune réclamation.</p></div>
      <% } else { %>
        <div class="flex flex-col gap-3">
          <% const statutStyle = { ouverte: 'bg-[#f6f3f1] text-[#55433d]', en_cours: 'bg-[#fff3cd] text-[#856404]', resolue: 'bg-[#d4e8d0] text-[#3a4b39]', fermee: 'bg-[#e5e2e0] text-[#55433d]' }; %>
          <% reclamations.forEach(r => { %>
            <div class="bg-white rounded-2xl p-5 shadow-sm flex items-center justify-between gap-4">
              <div>
                <p class="font-medium text-sm"><%= r.sujet %></p>
                <p class="text-xs text-[#55433d] mt-1"><%= r.description %></p>
              </div>
              <span class="px-2.5 py-1 rounded-full text-xs font-medium <%= statutStyle[r.statut] || 'bg-[#f6f3f1] text-[#55433d]' %>"><%= r.statut %></span>
            </div>
          <% }) %>
        </div>
      <% } %>
    </main>
  </div>
</body>
</html>